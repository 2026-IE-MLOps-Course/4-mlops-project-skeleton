# Stage 3: allow DVC pointers, keep local data-versioning settings and caches out of Git
# Why: share the input version without sharing data bytes or credentials
# .gitignore  [What Git must never track]
# Purpose: keep data, secrets and generated files out of GitHub
# Kept as real rules on purpose: a missing rule can leak personal data or secrets

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Environments and secrets
.env
.env.*
!.env.example
.venv/
env/
venv/

# Tooling
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# OS and IDE
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json

# Data: never in Git by default (it may hold personal or confidential information)
data/**
!data/
!data/raw/
!data/processed/
!data/inference/
!data/**/.gitkeep
!data/**/README.md
!data/**/*.dvc

# Generated outputs (recreated by: python -m src.main)
models/**
!models/
!models/README.md
!models/.gitkeep
reports/**
!reports/
!reports/README.md
!reports/.gitkeep

# Stage 3: logs and tracking outputs
logs/**
!logs/
!logs/README.md
*.log
wandb/
artifacts/

# DVC local settings and caches; shared .dvc/config stays versioned
.dvc/config.local
.dvc/tmp/
.dvc/cache/
